		<Metadata>
    <Identity Language="en-US" Id="devin-byok-bridge" Version="1.1.46" Publisher="byok-dev" />
			<DisplayName>Devin Model Gateway</DisplayName>
			<Description xml:space="preserve">Route Devin Cascade and Local model requests to custom OpenAI-compatible or native Anthropic APIs, with multi-provider configuration, model bindings, protocol adaptation, context management, and Remote SSH support.</Description>
			<Tags></Tags>
			<Categories>Other</Categories>
			<GalleryFlags>Public</GalleryFlags>

